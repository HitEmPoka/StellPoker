// Root of the committed rank table (deterministic; derived from RANK_TABLE).
pub fn rank_table_root() -> Field {
    merkle::compute_merkle_root_generic::<4096, 12>(constrain_fields(RANK_TABLE))
}

// Interpret the constant u32 table as Fields for Merkle hashing.
fn constrain_fields(table: [u32; 4096]) -> [Field; 4096] {
    let mut out: [Field; 4096] = [0; 4096];
    for i in 0..4096 {
        out[i] = table[i] as Field;
    }
    out
}

// Verify that `score` is an honestly-placed member of the committed rank table.
// `index` locates the leaf within the 4,096-leaf tree and `path` supplies the
// sibling hashes. On success the circuit may trust `score` for comparison.
pub fn verify_rank_in_table(score: u32, index: u32, path: [Field; 12], root: Field) {
    // The index must address the populated (non-padding) part of the table:
    // 2,847 real entries followed by zero padding.
    assert(index <= 2846, "rank index beyond table");
    assert(score != 0, "rank score cannot be zero");
    merkle::verify_merkle_proof_generic::<12>(score as Field, index, path, root);
}

// Return the table index at which a given score is stored (linear scan of the
// constant table), or 0 if unknown.
pub fn rank_index_of(score: u32) -> u32 {
    let mut idx: u32 = 0;
    for i in 0..2847 {
        if RANK_TABLE[i] == score {
            idx = i;
        }
    }
    idx
}

#[test]
fn test_rank_table_root_deterministic() {
    let r1 = rank_table_root();
    let r2 = rank_table_root();
    assert(r1 == r2, "rank root must be deterministic");
}

#[test]
fn test_rank_table_matches_legacy_evaluator() {
    // Regression guard (Issue #222): for representative hands the score the
    // committed lookup returns must match what the previous inline evaluator
    // (`cards::evaluate_hand_rank`) produced, so showdown winner/tie output for
    // game_type == 0 is unchanged.
    let root = rank_table_root();
    // Royal flush, full house, two low pairs and a bare high card.
    let hands: [[u32; 7]; 4] = [
        [51, 50, 49, 48, 47, 0, 1],
        [12, 25, 38, 0, 13, 26, 39],
        [0, 13, 26, 1, 14, 27, 5],
        [13, 3, 31, 47, 23, 1, 38],
    ];
    for h in 0..4 {
        let score = crate::cards::evaluate_hand_rank(hands[h]);
        let idx = rank_index_of(score);
        assert(RANK_TABLE[idx] == score, "legacy score must be in the table");
        let path = merkle::compute_merkle_proof_generic::<4096, 12>(
            constrain_fields(RANK_TABLE),
            idx,
        );
        verify_rank_in_table(score, idx, path, root);
    }
}

#[test]
fn test_rank_table_membership_accepts_real_ranking() {
    // 5 cards: royal flush in spades -> the maximum achievable score.
    let score: u32 = 10271384;
    let idx = rank_index_of(score);
    // A genuinely achievable score must be present at its located index.
    assert(RANK_TABLE[idx] == score);
    let root = rank_table_root();
    let path = merkle::compute_merkle_proof_generic::<4096, 12>(constrain_fields(RANK_TABLE), idx);
    verify_rank_in_table(score, idx, path, root);
}

#[test]
fn test_rank_table_rejects_unknown_score() {
    // A score that no legal 5-card hand can produce should not be located in
    // the table: rank_index_of returns 0 for unknown scores, and the stored
    // value there is 340496 (the minimum achievable), never the bogus score.
    let bogus: u32 = 1234567;
    let idx = rank_index_of(bogus);
    assert(RANK_TABLE[idx] != bogus, "bogus score must not be located");
}

#[test]
fn test_rank_table_padding_is_zero() {
    for i in 2847..4096 {
        assert(RANK_TABLE[i] == 0, "padding must be zero");
    }
}

#[test]
fn test_rank_table_fully_populated_prefix() {
    // All populated leaves must be non-zero and strictly increasing.
    for i in 1..2847 {
        assert(RANK_TABLE[i - 1] < RANK_TABLE[i], "table must be strictly increasing");
        assert(RANK_TABLE[i] != 0, "populated entries must be non-zero");
    }
    assert(RANK_TABLE[0] != 0, "first populated entry must be non-zero");
}
