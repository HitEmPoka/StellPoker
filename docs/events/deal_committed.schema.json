{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HitEmPoka/StellPoker/docs/events/deal_committed.schema.json",
  "title": "deal_committed",
  "description": "poker-table event. The committee committed the deal for the hand.",
  "type": "object",
  "required": [
    "topics",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "topics": {
      "x-soroban": "tuple",
      "type": "array",
      "prefixItems": [
        {
          "x-soroban": "symbol",
          "type": "string",
          "const": "deal_committed",
          "description": "Event name"
        },
        {
          "x-soroban": "u32",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Table id"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "data": {
      "x-soroban": "tuple",
      "type": "array",
      "prefixItems": [
        {
          "x-soroban": "u32",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Hand number"
        },
        {
          "x-soroban": "vec",
          "type": "array",
          "items": {
            "x-soroban": "bytes32",
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Hole card commitment"
          },
          "description": "One commitment per seat"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  }
}
