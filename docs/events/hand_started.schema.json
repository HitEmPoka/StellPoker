{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HitEmPoka/StellPoker/docs/events/hand_started.schema.json",
  "title": "hand_started",
  "description": "poker-table event. A new hand started.",
  "type": "object",
  "required": [
    "topics",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "topics": {
      "x-soroban": "tuple",
      "type": "array",
      "prefixItems": [
        {
          "x-soroban": "symbol",
          "type": "string",
          "const": "hand_started",
          "description": "Event name"
        },
        {
          "x-soroban": "u32",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Table id"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "data": {
      "x-soroban": "u32",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "Hand number"
    }
  }
}
