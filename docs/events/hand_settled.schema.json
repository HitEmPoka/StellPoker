{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HitEmPoka/StellPoker/docs/events/hand_settled.schema.json",
  "title": "hand_settled",
  "description": "poker-table event. A showdown was settled.",
  "type": "object",
  "required": [
    "topics",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "topics": {
      "x-soroban": "tuple",
      "type": "array",
      "prefixItems": [
        {
          "x-soroban": "symbol",
          "type": "string",
          "const": "hand_settled",
          "description": "Event name"
        },
        {
          "x-soroban": "u32",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Table id"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "data": {
      "x-soroban": "tuple",
      "type": "array",
      "prefixItems": [
        {
          "x-soroban": "address",
          "type": "string",
          "pattern": "^[GC][A-Z2-7]{55}$",
          "description": "Proved winner"
        },
        {
          "x-soroban": "i128",
          "type": "string",
          "pattern": "^-?[0-9]+$",
          "description": "Total pot before rake"
        },
        {
          "x-soroban": "vec",
          "type": "array",
          "items": {
            "x-soroban": "tuple",
            "type": "array",
            "prefixItems": [
              {
                "x-soroban": "u32",
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295,
                "description": "Seat index"
              },
              {
                "x-soroban": "i128",
                "type": "string",
                "pattern": "^-?[0-9]+$",
                "description": "Amount paid"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "description": "Payouts per seat"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    }
  }
}
