{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HitEmPoka/StellPoker/docs/events/player_action.schema.json",
  "title": "player_action",
  "description": "poker-table event. A player acted in a betting round.",
  "type": "object",
  "required": [
    "topics",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "topics": {
      "x-soroban": "tuple",
      "type": "array",
      "prefixItems": [
        {
          "x-soroban": "symbol",
          "type": "string",
          "const": "player_action",
          "description": "Event name"
        },
        {
          "x-soroban": "u32",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Table id"
        },
        {
          "x-soroban": "symbol",
          "type": "string",
          "enum": [
            "fold",
            "check",
            "call",
            "bet",
            "raise",
            "all_in"
          ],
          "description": "Action type"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "data": {
      "x-soroban": "tuple",
      "type": "array",
      "prefixItems": [
        {
          "x-soroban": "address",
          "type": "string",
          "pattern": "^[GC][A-Z2-7]{55}$",
          "description": "Player"
        },
        {
          "x-soroban": "i128",
          "type": "string",
          "pattern": "^-?[0-9]+$",
          "description": "Chips added to the pot by this action"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  }
}
